.zshrc.local

# claude/ is symlinked to ~/.claude (live runtime state, incl. credentials
# and session transcripts). Only hand-authored config is safe to track.
claude/*
!claude/CLAUDE.md
!claude/settings.json
!claude/agent-skills/
!claude/agent-skills/**
!claude/agent-rules/
!claude/agent-rules/**
!claude/agent-guard/
!claude/agent-guard/*.sh
!claude/skills/
!claude/skills/task-kickoff/
!claude/skills/task-kickoff/**
!claude/skills/pr-ready-check/
!claude/skills/pr-ready-check/**
!claude/skills/pr-writing/
!claude/skills/pr-writing/**

# vim
*.un~
claude/skills/synced/
claude/agent-guard/audit/
